# Copie este arquivo para .env.prod e preencha. NAO commite o .env.prod de verdade
# (ja fica coberto pelo .gitignore junto com o resto de .env*).

# Dominio publico da VPS. Sem dominio proprio, use o sslip.io (gratis, zero cadastro):
# troque os pontos do IP por hifen e' completa com ".sslip.io".
# Ex: IP 203.0.113.7 -> DOMAIN=203-0-113-7.sslip.io
DOMAIN=

# Senha do usuario "postgres" no banco (so' precisa bater aqui, o compose cria sozinho).
DB_PASSWORD=troque-esta-senha

# Senha da conta admin criada automaticamente na primeira subida do backend.
ADMIN_PASSWORD=troque-esta-senha-tambem

# Chave/segredo do LiveKit - INVENTE valores fortes e unicos para producao (o segredo
# precisa ter pelo menos 32 caracteres). Nao reaproveite o devkey/devsecret do docker-compose.yml de dev.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Upload de avatar/imagens/anexos - Cloudflare R2 (opcional - deixe em branco se nao for usar
# por enquanto). R2_ACCOUNT_ID e' o ID da sua conta Cloudflare (aparece na URL do painel do R2);
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY vem de um token de API do R2 (R2 > Manage API Tokens);
# R2_PUBLIC_BASE_URL e' a URL publica do bucket, SEM barra no final (ex:
# https://pub-xxxxxxxx.r2.dev ou um dominio proprio apontado pro bucket via Cloudflare).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Integracao com Spotify ("ouvindo Spotify" na lista de membros/perfil - opcional, deixe em
# branco se nao for usar). Client ID/Secret vem do app criado em
# https://developer.spotify.com/dashboard - a Redirect URI cadastrada la' precisa ser
# EXATAMENTE https://SEU-DOMINIO/api/spotify/callback (ver docker-compose.prod.yml, que ja'
# monta isso sozinho a partir de DOMAIN acima).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
