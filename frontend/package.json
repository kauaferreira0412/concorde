{
  "name": "concorde-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win nsis --publish=never",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@stomp/stompjs": "^7.0.0",
    "axios": "^1.7.7",
    "livekit-client": "^2.5.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "optionalDependencies": {
    "process-audio-capture": "^1.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.concorde.app",
    "productName": "Concorde",
    "copyright": "Copyright © Concorde",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/process-audio-capture/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "!node_modules/process-audio-capture/src/**/*",
      "!node_modules/process-audio-capture/include/**/*",
      "!node_modules/process-audio-capture/build/**/*.obj",
      "!node_modules/process-audio-capture/build/*.sln",
      "!node_modules/process-audio-capture/build/**/*.vcxproj*",
      "!dist/downloads/**/*"
    ],
    "asarUnpack": [
      "node_modules/process-audio-capture/**/*",
      "electron/native/hwnd-utils/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concorde"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon-512.png",
      "category": "Network"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
