{
  "expo": {
    "name": "Concorde",
    "slug": "concorde-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.codagis.concorde",
      "adaptiveIcon": {
        "backgroundColor": "#8EE6D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2B1A63"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Concorde acessa suas fotos pra você mandar imagens no chat.",
          "cameraPermission": "O Concorde usa a câmera nas calls e pra tirar fotos pro chat."
        }
      ],
      "expo-asset",
      "./plugins/withWindowsCxxStagingDir.js",
      "expo-image",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CallsWidget",
              "label": "Em call agora",
              "description": "Quem está em call nos seus servidores. Toque pra entrar.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.codagis.concorde",
      "appleTeamId": "4Z544V82DV",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Concorde usa o microfone pra você falar nas calls de voz.",
        "NSCameraUsageDescription": "O Concorde usa a câmera nas calls com vídeo.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.codagis.concorde"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "467c5e68-1e8d-457b-8bd9-e5aa93874bd6"
      }
    },
    "owner": "lkaio16",
    "scheme": "concorde"
  }
}
